# Vite loads this file in production-mode builds, including Vercel previews.
# The frontend (Vercel) and the API (Render) are on different origins, and
# vercel.json sends every unknown path to index.html, so a relative /api would
# never reach FastAPI. Use the public Render API URL (not a secret). A Vercel
# environment variable with the same name overrides this per environment.
VITE_API_BASE_URL=https://helix-intelligence-ai.onrender.com/api
