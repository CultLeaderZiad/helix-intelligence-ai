# === REQUIRED ===
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?ssl=require
SECRET_KEY=your_jwt_secret_key_here

# === AUTH / PASSWORD RESET ===
# Public frontend origin used to build password-reset links
PUBLIC_APP_BASE_URL=https://helix-intelligence-ai-six.vercel.app
# Minutes a password reset link stays valid
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# No mail provider is bundled, so the reset link is logged server-side on
# every request. Set to true to ALSO return it directly in the API response
# (dev/staging convenience ONLY — anyone who can call the endpoint could
# reset any account). Turn this off once real email delivery is wired up.
AUTH_DEV_RESET_RETURN=true

# === HIGGSFIELD AI (MEDIA GENERATION) ===
# Credentials from https://platform.higgsfield.ai
HF_API_KEY_ID=your_higgsfield_key_id
HF_API_KEY_SECRET=your_higgsfield_key_secret
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
PUBLIC_API_BASE_URL=https://helix-intelligence-ai.onrender.com/api

# === AI LLM & PATTERN SYNTHESIS ===
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# === SCRAPING PROVIDERS (Discover ad search chain) ===
# Tried in this exact order; the first source that answers wins. A source with
# no credentials here is SKIPPED, not failed — and if every source is skipped,
# the search is reported as `providers_unavailable` and refunded, never as
# "this brand has no ads".
METAPI_API_KEY=
ADYNTEL_API_KEY=
ADYNTEL_EMAIL=
META_ACCESS_TOKEN=
# Apify is a paid actor. APIFY_ENABLED is a deliberate kill switch: with a
# token but APIFY_ENABLED=false the source stays skipped (no calls, no spend).
APIFY_API_TOKEN=
APIFY_ENABLED=false
SCRAPEGRAPH_API_KEY=
BRIGHTDATA_API_KEY=
# Meta Ad Library needs MORE than a token: the app must hold ads_archive
# access or every query returns HTTP 400 subcode 2332002.

# === FRONTEND ===
VITE_API_BASE_URL=https://helix-intelligence-ai.onrender.com/api
