# === REQUIRED ===
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?ssl=require
SECRET_KEY=your_jwt_secret_key_here

# === AUTH / PASSWORD RESET ===
# Public frontend origin used to build password-reset links
PUBLIC_APP_BASE_URL=https://helix-intelligence-ai-six.vercel.app
# Minutes a password reset link stays valid
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# No mail provider is bundled, so the reset link is logged server-side on
# every request. Set to true to ALSO return it directly in the API response
# (dev/staging convenience ONLY — anyone who can call the endpoint could
# reset any account). Turn this off once real email delivery is wired up.
AUTH_DEV_RESET_RETURN=true

# === HIGGSFIELD AI (MEDIA GENERATION) ===
# Credentials from https://platform.higgsfield.ai
HF_API_KEY_ID=your_higgsfield_key_id
HF_API_KEY_SECRET=your_higgsfield_key_secret
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
PUBLIC_API_BASE_URL=https://helix-intelligence-ai.onrender.com/api

# === OBJECT STORAGE (Cloudflare R2) ===
# Without these, generated media is written to the local disk, which Render
# destroys on every restart and deploy. All five must be set together or R2
# stays off. R2_PUBLIC_BASE_URL is the bucket's public read origin (its r2.dev
# subdomain or a custom domain) and is required so stored URLs never expire.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# === MONITORS (scheduled competitor watches) ===
# Shared secret the scheduler sends as the X-Cron-Secret header when calling
# POST /api/monitors/tick. While this is unset the tick endpoint refuses every
# request, so monitors never run. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
# How many due monitors a single tick may start. Each one is a full discovery
# run on the web instance, so this is the backpressure valve.
MONITOR_MAX_PER_TICK=3
# Consecutive runs an ad must be missing before it is reported as stopped.
# Lowering this to 1 will report false "stopped" ads whenever a scrape is flaky.
MONITOR_MISS_THRESHOLD=2
# Consecutive failed runs before a monitor pauses itself.
MONITOR_MAX_FAILURES=5

# === EMAIL (Resend) ===
# Optional. Without both of these, monitor alerts are delivered in-app only and
# the email step is skipped with a log line rather than failing the run.
# Create a key at https://resend.com/api-keys. Until a domain is verified,
# RESEND_FROM=Helix Intelligence <onboarding@resend.dev> can only send to the
# Resend-account inbox (and to delivered@resend.dev for a delivery-event test).
RESEND_API_KEY=
RESEND_FROM=Helix Intelligence <onboarding@resend.dev>
# Origin used to build "View in Helix" links inside emails. Local default is
# fine for the UI; production / Render must be the live Vercel origin or the
# button in the inbox opens localhost.
APP_BASE_URL=http://localhost:5173

# === AI LLM & PATTERN SYNTHESIS ===
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# === SCRAPING PROVIDERS ===
METAPI_API_KEY=
ADYNTEL_API_KEY=
ADYNTEL_EMAIL=
APIFY_API_TOKEN=
SCRAPEGRAPH_API_KEY=
BRIGHTDATA_API_KEY=
META_ACCESS_TOKEN=

# === FRONTEND ===
VITE_API_BASE_URL=https://helix-intelligence-ai.onrender.com/api
